# ==========================================
# Flask Environment Variables Template
# ==========================================
# Copy this file to a new file named .env 
# and fill in your actual values.
# NEVER commit the real .env file to GitHub!

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development

# Security
# Generate a strong random string for your SECRET_KEY.
# You can generate one by running this in your terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_your_actual_random_secret_key